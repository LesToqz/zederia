{
  "kind": "table",
  "name": "Whisper Vowels",
  "category": "Formant",
  "frames": 5,
  "morph": "spectral",
  "about": "A, E, I, O and U on a flat, gapped source: vowels with air instead of a firm voice.",
  "steps": [
    { "op": "formula", "domain": "harmonics", "frames": [0, 0], "expr": "pow(h, -0.25) * (0.02 + exp(-((h - 6.64)/1.6)^2) + 0.8*exp(-((h - 9.91)/2)^2) + 0.5*exp(-((h - 22.2)/3)^2))" },
    { "op": "formula", "domain": "harmonics", "frames": [1, 1], "expr": "pow(h, -0.25) * (0.02 + exp(-((h - 4.82)/1.5)^2) + 0.8*exp(-((h - 16.7)/2.2)^2) + 0.5*exp(-((h - 22.5)/3)^2))" },
    { "op": "formula", "domain": "harmonics", "frames": [2, 2], "expr": "pow(h, -0.25) * (0.02 + exp(-((h - 2.45)/1.2)^2) + 0.8*exp(-((h - 20.8)/2.4)^2) + 0.5*exp(-((h - 27.4)/3.2)^2))" },
    { "op": "formula", "domain": "harmonics", "frames": [3, 3], "expr": "pow(h, -0.25) * (0.02 + exp(-((h - 5.18)/1.5)^2) + 0.8*exp(-((h - 7.64)/1.8)^2) + 0.5*exp(-((h - 21.9)/3)^2))" },
    { "op": "formula", "domain": "harmonics", "frames": [4, 4], "expr": "pow(h, -0.25) * (0.02 + exp(-((h - 2.73)/1.2)^2) + 0.8*exp(-((h - 7.91)/1.8)^2) + 0.5*exp(-((h - 20.4)/3)^2))" },
    { "op": "harmonic", "name": "random_gaps", "amount": 0.3, "seed": 9 },
    { "op": "formula", "domain": "harmonics", "expr": "h == 1 ? max(in, 0.05) : in" },
    { "op": "process", "name": "normalize_each" }
  ]
}
