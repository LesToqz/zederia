{
  "kind": "table",
  "name": "Drawbar Organ",
  "category": "Harmonic",
  "frames": 8,
  "morph": "crossfade",
  "about": "Eight organ registrations on the footages 8, 4, 2 2/3, 2, 1 3/5, 1 1/3 and 1, from a single flute to every bar out; 3 dB per drawbar step.",
  "steps": [
    { "op": "formula", "domain": "harmonics", "frames": [0, 0], "expr": "h == 1 ? 1 : 0" },
    { "op": "formula", "domain": "harmonics", "frames": [1, 1], "expr": "h == 1 ? 1 : h == 2 ? 1 : 0" },
    { "op": "formula", "domain": "harmonics", "frames": [2, 2], "expr": "h == 1 ? 1 : h == 2 ? 0.501 : h == 3 ? 1 : 0" },
    { "op": "formula", "domain": "harmonics", "frames": [3, 3], "expr": "h == 1 ? 1 : h == 2 ? 1 : h == 3 ? 1 : 0" },
    { "op": "formula", "domain": "harmonics", "frames": [4, 4], "expr": "h == 1 ? 1 : h == 2 ? 1 : h == 3 ? 1 : h == 4 ? 0.501 : 0" },
    { "op": "formula", "domain": "harmonics", "frames": [5, 5], "expr": "h == 1 ? 1 : h == 2 ? 1 : h == 3 ? 1 : h == 4 ? 1 : h == 6 ? 0.251 : 0" },
    { "op": "formula", "domain": "harmonics", "frames": [6, 6], "expr": "h == 1 ? 1 : h == 2 ? 0.501 : h == 3 ? 1 : h == 4 ? 1 : h == 5 ? 0.501 : h == 6 ? 1 : h == 8 ? 0.501 : 0" },
    { "op": "formula", "domain": "harmonics", "frames": [7, 7], "expr": "(h == 1 || h == 2 || h == 3 || h == 4 || h == 5 || h == 6 || h == 8) ? 1 : (h == 7 || h == 9) ? 0.02 : 0" },
    { "op": "process", "name": "normalize_each" }
  ]
}
