{
  "format": "zederia.patch",
  "version": 1,
  "meta": { "name": "Test Lead", "author": "", "type": "lead", "tags": ["mono", "expressive"] },
  "global": { "mode": "mono", "polyphony": 1, "glide_ms": 80, "glide_curve": 0.3, "glide_mode": "always", "bend_range": [12, 12], "master_db": -6.0 },
  "osc1": {
    "on": true, "engine": "classic", "level_db": -6.0,
    "classic": { "shape": 0.1, "pulse_width": 0.4 },
    "unison": { "voices": 3, "detune": 0.1, "width": 0.5 }
  },
  "osc2": { "on": true, "octave": 1, "level_db": -14.0, "sends": { "direct": 0.3 } },
  "filter1": { "on": true, "type": "ladder_lp18", "cutoff_hz": 700, "resonance": 0.3, "drive": 0.2, "keytrack": 0.6 },
  "env1": { "attack_ms": 4, "decay_ms": 300, "sustain": 0.75, "release_ms": 160 },
  "lfo1": {
    "mode": "retrigger", "rate_hz": 5.5, "delay_ms": 250, "rise_ms": 400,
    "shape": { "points": [ { "x": 0, "y": 0 }, { "x": 0.25, "y": 1 }, { "x": 0.75, "y": -1 }, { "x": 1, "y": 0 } ] }
  },
  "mod": [
    { "source": "lfo1", "dest": "osc1.fine", "amount": 0.12, "polarity": "bi" },
    { "source": "lfo1", "dest": "osc2.fine", "amount": 0.12, "polarity": "bi" },
    { "source": "lfo1", "via": "modwheel", "dest": "filter1.cutoff", "amount": 0.08, "polarity": "bi" },
    { "source": "velocity", "dest": "filter1.cutoff", "amount": 0.15, "polarity": "uni" },
    { "source": "macro1", "dest": "filter1.cutoff", "amount": 0.3, "polarity": "uni" },
    { "source": "note", "dest": "osc1.classic.pulse_width", "amount": 0.2, "polarity": "bi" }
  ],
  "macros": [ { "name": "Bright", "value": 0.3 } ]
}
