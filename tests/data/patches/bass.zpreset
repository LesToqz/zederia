{
  "format": "zederia.patch",
  "version": 1,
  "meta": { "name": "Test Bass", "author": "", "type": "bass", "tags": ["mono", "warm"] },
  "global": { "mode": "legato", "polyphony": 1, "glide_ms": 60, "glide_mode": "legato", "bend_range": [2, 12], "master_db": -6.0 },
  "voice": { "priority": "low", "warmth": 0.35, "drift": 0.1 },
  "osc1": {
    "on": true, "engine": "classic", "octave": -1, "level_db": -4.0, "phase_random": 0.0,
    "classic": { "shape": 0.0 }
  },
  "sub": { "on": true, "shape": "sine", "octave": -1, "level_db": -6.0 },
  "filter1": { "on": true, "type": "ladder_lp24", "cutoff_hz": 160, "resonance": 0.3, "drive": 0.35, "character": 0.4, "keytrack": 0.3 },
  "env1": { "attack_ms": 2, "decay_ms": 260, "sustain": 0.7, "release_ms": 110, "decay_curve": 0.5 },
  "env2": { "attack_ms": 0, "decay_ms": 220, "sustain": 0.1, "release_ms": 100, "decay_curve": 0.6 },
  "mod": [
    { "source": "env2", "dest": "filter1.cutoff", "amount": 0.4, "polarity": "uni" },
    { "source": "velocity", "dest": "filter1.cutoff", "amount": 0.12, "polarity": "uni" },
    { "source": "modwheel", "dest": "filter1.resonance", "amount": 0.4, "polarity": "uni" }
  ]
}
