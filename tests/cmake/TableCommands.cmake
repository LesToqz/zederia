# Runs the wavetable toolkit end to end through zederia-cli: every table subcommand once, on
# files made by the commands before it. Any command that fails stops the test.
#   cmake -DCLI=<zederia-cli> -DOUT=<work folder> -DDATA=<tests/data> -DCONTENT=<content> -P TableCommands.cmake
file(REMOVE_RECURSE ${OUT})
file(MAKE_DIRECTORY ${OUT})

function(run)
    execute_process(COMMAND ${CLI} ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        string(REPLACE ";" " " shown "${ARGN}")
        message(FATAL_ERROR "zederia-cli ${shown}\nexit code ${rc}\n${out}${err}")
    endif()
    set(last_output "${out}" PARENT_SCOPE)
endfunction()

# Must fail, with a message that matches.
function(refuse pattern)
    execute_process(COMMAND ${CLI} ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    string(REPLACE ";" " " shown "${ARGN}")
    if(rc EQUAL 0)
        message(FATAL_ERROR "zederia-cli ${shown}\nshould have failed")
    endif()
    if(NOT "${err}" MATCHES "${pattern}")
        message(FATAL_ERROR "zederia-cli ${shown}\nexpected a message matching \"${pattern}\", got:\n${err}")
    endif()
endfunction()

# The starter content, built from its recipes.
run(content build --in ${CONTENT} --out ${OUT}/factory)
if(NOT "${last_output}" MATCHES "built 12 wavetable.s. and 6 texture.s.")
    message(FATAL_ERROR "content build did not build the starter set:\n${last_output}")
endif()

# Formula, in both domains, and the frame tools.
run(table new --frames 4 --name Scratch --out ${OUT}/blank.wav)
run(table formula --in ${OUT}/blank.wav --expr "sin(tau*t) * (1 - y) + saw(t) * y" --out ${OUT}/morph.wav)
run(table formula --frames 6 --domain harmonics --expr "1/h * (h % 2)" --normalize --morph spectral --out ${OUT}/odd.wav)
run(table formula --in ${OUT}/odd.wav --domain harmonics --expr "in" --phase "rand * pi" --scope 2-3 --seed 4 --out ${OUT}/odd2.wav)
run(table info ${OUT}/odd.wav)
if(NOT "${last_output}" MATCHES "key frames +6" OR NOT "${last_output}" MATCHES "morph +spectral")
    message(FATAL_ERROR "table info did not report the table:\n${last_output}")
endif()
run(table info ${OUT}/odd.wav --json)
if(NOT "${last_output}" MATCHES "\"positions_played\": 256")
    message(FATAL_ERROR "table info --json did not report the generated positions:\n${last_output}")
endif()
run(table process --in ${OUT}/morph.wav --op remove_dc --out ${OUT}/p1.wav)
run(table process --in ${OUT}/p1.wav --op low_pass --n 64 --scope 1-2 --out ${OUT}/p2.wav)
run(table process --in ${OUT}/p2.wav --op normalize_each --out ${OUT}/p3.wav --bits 24)
run(table harmonic --in ${OUT}/p3.wav --op fade_highs --amount 0.5 --out ${OUT}/h1.wav)
run(table harmonic --in ${OUT}/h1.wav --op randomize_lowest --n 8 --seed 3 --scope 0 --out ${OUT}/h2.wav)
run(table frames --in ${OUT}/h2.wav --op duplicate --scope 0-1 --out ${OUT}/f1.wav)
run(table frames --in ${OUT}/f1.wav --op move --from 0 --to 3 --out ${OUT}/f2.wav)
run(table frames --in ${OUT}/f2.wav --op delete --scope 5 --out ${OUT}/f3.wav)
run(table frames --in ${OUT}/f3.wav --op thin --every 2 --out ${OUT}/f4.wav)
run(table frames --in ${OUT}/f3.wav --op split --out ${OUT}/f5.wav)
run(table frames --in ${OUT}/f5.wav --op join --out ${OUT}/f6.wav)
run(table frames --in ${OUT}/f3.wav --op reverse --out ${OUT}/f7.wav)
run(table frames --in ${OUT}/f3.wav --op copy_spectrum --source 1 --out ${OUT}/f8.wav)
run(table morph --in ${OUT}/f3.wav --mode spectral_aligned --out ${OUT}/m1.wav)
run(table morph --in ${OUT}/m1.wav --bake 32 --out ${OUT}/m2.wav)
run(table morph --in ${OUT}/m2.wav --mode none --stepped on --out ${OUT}/m3.wav)
run(table sort --in ${OUT}/m2.wav --by brightness --descending --out ${OUT}/s1.wav)

# Resynthesis and export.
run(table resynth --op bake-warp --in ${OUT}/morph.wav --mode bend_plus --position 1.0 --frames 16 --out ${OUT}/warp.wav)
run(table resynth --op bake-patch --patch ${DATA}/patches/glass_pluck.zpreset --content ${OUT}/factory --bars 0.25 --frames 8 --out ${OUT}/baked.wav)
run(table resynth --op shape --values "0, 1, 0.2, 0.8, 0" --unipolar --out ${OUT}/shape.wav)
run(table export --in ${OUT}/m2.wav --scope 4-9 --out ${OUT}/selection.wav)
run(table export --in ${OUT}/odd.wav --generated 64 --out ${OUT}/generated.wav)
run(table export --in ${OUT}/morph.wav --out-dir ${OUT}/cycles)
file(GLOB cycles ${OUT}/cycles/*.wav)
list(LENGTH cycles count)
if(NOT count EQUAL 4)
    message(FATAL_ERROR "expected 4 single-cycle files, found ${count}")
endif()

# Import: every method.
list(GET cycles 0 cycle0)
list(GET cycles 3 cycle3)
run(table import ${cycle0} ${cycle3} --method cycles --out ${OUT}/i_cycles.wav)
run(table import ${OUT}/generated.wav --method table --out ${OUT}/i_table.wav)
run(table import ${OUT}/generated.wav --out ${OUT}/i_auto.wav)
if(NOT "${last_output}" MATCHES "method: table")
    message(FATAL_ERROR "import did not recognize a table file:\n${last_output}")
endif()
# A rendered note is a pitched recording: A2 at 110 Hz.
run(render --notes "A2:0:1.5" --out ${OUT}/note.wav --bits 24 --tail 0)
run(table import ${OUT}/note.wav --method pitch --snap --max-frames 32 --out ${OUT}/i_pitch.wav)
if(NOT "${last_output}" MATCHES "found [0-9]+ cycles of about 436\\.[0-9]+ samples \\(110\\.[0-9]+ Hz\\)")
    message(FATAL_ERROR "pitch-tracked import did not find the note's pitch:\n${last_output}")
endif()
run(table import ${OUT}/note.wav --method fixed --note A2 --max-frames 16 --average --out ${OUT}/i_fixed.wav)
run(table import ${OUT}/note.wav --method fixed --cycle-samples 436.3636 --channel left --out ${OUT}/i_fixed2.wav)
run(table import ${OUT}/note.wav --method spectral --fft 1024 --frames 12 --phase random --seed 9 --out ${OUT}/i_spectral.wav)
run(table import ${OUT}/note.wav --method pitch --channel split --max-frames 8 --normalize --fade-edges 16 --out ${OUT}/i_split.wav)
if(NOT EXISTS ${OUT}/i_split_left.wav OR NOT EXISTS ${OUT}/i_split_right.wav)
    message(FATAL_ERROR "--channel split did not write the left and right tables")
endif()
run(table import ${DATA}/images/gradient_rgb.png --method image --out ${OUT}/i_image.wav)
run(table import ${DATA}/images/gradient_rgb.png --method image --image-mode harmonics --max-frames 8 --out ${OUT}/i_image2.wav)

# Recipes.
run(table build ${CONTENT}/wavetables/vowel_drift.json --out ${OUT}/vowel.wav)
run(texture build ${CONTENT}/textures/dust_crackle.json --out ${OUT}/crackle.wav)
run(texture build ${CONTENT}/textures/white_noise.json --out ${OUT}/noise.wav)

# A patch that names a factory table and sample renders with them.
run(render --patch ${DATA}/patches/glass_pluck.zpreset --content ${OUT}/factory --notes "C3:0:0.4" --out ${OUT}/pluck.wav)

# Mistakes are refused with a message that says what to do.
refuse("column 10: missing" table formula --frames 2 --expr "sin(tau*t" --out ${OUT}/x.wav)
refuse("unknown function" table formula --frames 2 --expr "sine(t)" --out ${OUT}/x.wav)
refuse("--op" table process --in ${OUT}/morph.wav --op polish --out ${OUT}/x.wav)
refuse("--scope" table process --in ${OUT}/morph.wav --op clear --scope 3-1 --out ${OUT}/x.wav)
refuse("at least|does not fit" table frames --in ${OUT}/morph.wav --op delete --out ${OUT}/x.wav)
refuse("not a WAV" table info ${DATA}/patches/glass_pluck.zpreset)
refuse("no clear pitch" table import ${OUT}/noise.wav --method pitch --out ${OUT}/x.wav)
refuse("--mode must be one of" table resynth --op bake-warp --in ${OUT}/morph.wav --mode wobble --out ${OUT}/x.wav)
refuse("subcommand" table)
refuse("step 1" table build ${DATA}/recipes/broken_recipe.json --out ${OUT}/x.wav)
