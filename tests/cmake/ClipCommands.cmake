# The clip commands end to end: the notes an arpeggio makes become a MIDI file, the file becomes
# a clip in a patch, the clip goes back out to a file, and importing that file again gives the
# same patch.
file(MAKE_DIRECTORY ${OUT})
function(run)
    execute_process(COMMAND ${CLI} ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT rc EQUAL 0)
        message(FATAL_ERROR "zederia-cli ${ARGN} failed: ${out}${err}")
    endif()
    message(STATUS "${out}")
endfunction()
run(render --patch ${PATCH} --notes "A2:0:1, C3:0:1, E3:0:1" --tail 0.5 --out ${OUT}/arp.wav --midi-out ${OUT}/arp.mid)
run(clip import ${OUT}/arp.mid --slot 2 --out ${OUT}/with_clip.zpreset)
run(validate-patch ${OUT}/with_clip.zpreset)
run(clip export --patch ${OUT}/with_clip.zpreset --slot 2 --out ${OUT}/again.mid)
run(clip import ${OUT}/again.mid --slot 2 --out ${OUT}/again.zpreset)
file(SHA256 ${OUT}/with_clip.zpreset first)
file(SHA256 ${OUT}/again.zpreset second)
if(NOT first STREQUAL second)
    message(FATAL_ERROR "a clip that went out to a file and back in changed")
endif()
file(SHA256 ${OUT}/arp.mid made)
file(SHA256 ${OUT}/again.mid exported)
if(NOT made STREQUAL exported)
    message(FATAL_ERROR "the exported clip differs from the file it came from")
endif()
